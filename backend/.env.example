# Copy to .env and fill in real values before running

# PostgreSQL connection string. If you don't have Postgres running locally,
# `docker-compose up -d` at the repo root will start one on port 5432
# matching the values below.
DATABASE_URL="postgresql://qa_user:qa_password@localhost:5432/qa_test_management?schema=public"

# Any long random string. Rotate this in production.
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
