// Prisma schema — mirrors Documents/TestHub/04 - Database/Database Design.md
// and Entity Relationship.md in the project's Obsidian vault. Keep them in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  roleId    String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                Role               @relation(fields: [roleId], references: [id])
  ownedProjects       Project[]          @relation("ProjectOwner")
  projectMemberships  ProjectMember[]
  createdTestCases    TestCase[]         @relation("TestCaseCreatedBy")
  updatedTestCases     TestCase[]         @relation("TestCaseUpdatedBy")
  testCaseHistory     TestCaseHistory[]
  createdTestRuns     TestRun[]
  testerExecutions    TestExecution[]
  reportedDefects     Defect[]           @relation("DefectReportedBy")
  assignedDefects     Defect[]           @relation("DefectAssignee")
  defectStatusChanges DefectStatusHistory[]
  attachments         Attachment[]
  notifications       Notification[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  rolePermissions   RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ───────────────────────── Projects ─────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  key         String        @unique
  description String?
  status      ProjectStatus @default(PLANNING)
  ownerId     String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner    User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members  ProjectMember[]
  suites   TestSuite[]
  runs     TestRun[]
  defects  Defect[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  projectRole String
  addedAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ───────────────────────── Test design ─────────────────────────

model TestSuite {
  id          String   @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  description String?
  status      SuiteStatus @default(ACTIVE)

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     TestSuite?  @relation("SuiteHierarchy", fields: [parentId], references: [id])
  children   TestSuite[] @relation("SuiteHierarchy")
  testCases  TestCase[]

  @@map("test_suites")
}

enum SuiteStatus {
  ACTIVE
  ARCHIVED
}

model TestCase {
  id            String   @id @default(cuid())
  suiteId       String
  requirementId String?  // e.g. "FR-013" — optional link back to FRD.md
  title         String
  description   String?
  preconditions String?
  priority      Priority @default(MEDIUM)
  type          TestCaseType @default(FUNCTIONAL)
  status        TestCaseStatus @default(DRAFT)
  createdById   String
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  suite       TestSuite          @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("TestCaseCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("TestCaseUpdatedBy", fields: [updatedById], references: [id])
  steps       TestStep[]
  history     TestCaseHistory[]
  executions  TestExecution[]
  runLinks    TestRunCase[]
  defects     Defect[]

  @@map("test_cases")
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestCaseType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  SANITY
  INTEGRATION
  UI
  API
  SECURITY
}

// Draft -> Review -> Ready -> Deprecated. See Test Case Workflow.md.
enum TestCaseStatus {
  DRAFT
  REVIEW
  READY
  DEPRECATED
}

model TestStep {
  id              String @id @default(cuid())
  testCaseId      String
  stepNumber      Int
  action          String
  testData        String?
  expectedResult  String

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, stepNumber])
  @@map("test_steps")
}

model TestCaseHistory {
  id            String       @id @default(cuid())
  testCaseId    String
  changedById   String
  changeType    HistoryChangeType
  previousValue Json?
  newValue      Json?
  changedAt     DateTime     @default(now())

  testCase  TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@map("test_case_history")
}

enum HistoryChangeType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ARCHIVED
}

// ───────────────────────── Test execution ─────────────────────────

model TestRun {
  id            String        @id @default(cuid())
  projectId     String
  name          String
  buildVersion  String?
  environment   String?
  status        TestRunStatus @default(NOT_STARTED)
  startDate     DateTime?
  endDate       DateTime?
  createdById   String
  createdAt     DateTime      @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User            @relation(fields: [createdById], references: [id])
  runCases   TestRunCase[]
  executions TestExecution[]

  @@map("test_runs")
}

enum TestRunStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Join table: which test cases were assigned into a given run
model TestRunCase {
  id         String @id @default(cuid())
  testRunId  String
  testCaseId String

  testRun  TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testRunId, testCaseId])
  @@map("test_run_cases")
}

model TestExecution {
  id           String          @id @default(cuid())
  testRunId    String
  testCaseId   String
  testerId     String
  status       ExecutionStatus @default(NOT_RUN)
  actualResult String?
  comment      String?
  executedAt   DateTime?

  testRun     TestRun      @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase    TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  tester      User         @relation(fields: [testerId], references: [id])
  defects     Defect[]
  attachments Attachment[]

  @@map("test_executions")
}

enum ExecutionStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

// ───────────────────────── Defects ─────────────────────────

model Defect {
  id                 String        @id @default(cuid())
  projectId          String
  testCaseId         String?
  executionId        String?
  title              String
  description        String
  severity           Severity
  priority           Priority
  status             DefectStatus  @default(NEW)
  assigneeId         String?
  stepsToReproduce   String
  expectedResult     String
  actualResult       String
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase    TestCase?             @relation(fields: [testCaseId], references: [id])
  execution   TestExecution?        @relation(fields: [executionId], references: [id])
  assignee    User?                 @relation("DefectAssignee", fields: [assigneeId], references: [id])
  createdBy   User                  @relation("DefectReportedBy", fields: [createdById], references: [id])
  history     DefectStatusHistory[]
  attachments Attachment[]

  @@map("defects")
}

enum Severity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

// New -> Assigned -> In Progress -> Resolved -> Retest -> Closed
// New/Assigned -> Rejected (terminal)
// Retest fail -> Reopened -> In Progress
// See Defect Workflow.md.
enum DefectStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  RETEST
  CLOSED
  REOPENED
  REJECTED
}

model DefectStatusHistory {
  id          String       @id @default(cuid())
  defectId    String
  fromStatus  DefectStatus?
  toStatus    DefectStatus
  changedById String
  changedAt   DateTime     @default(now())

  defect    Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@map("defect_status_history")
}

// ───────────────────────── Shared / cross-cutting ─────────────────────────

model Attachment {
  id           String         @id @default(cuid())
  fileName     String
  filePath     String
  fileType     String?
  entityType   AttachmentEntity
  executionId  String?
  defectId     String?
  uploadedById String
  createdAt    DateTime       @default(now())

  execution  TestExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  defect     Defect?        @relation(fields: [defectId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}

enum AttachmentEntity {
  TEST_EXECUTION
  DEFECT
}

model Notification {
  id              String   @id @default(cuid())
  recipientId     String
  type            String
  referenceEntity String
  referenceId     String
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
